# Lawexa frontend — environment reference.
# Copy to .env.local for development. NEXT_PUBLIC_* values are inlined at BUILD
# time, so they must be present in the build environment (Coolify build args),
# not just at runtime.

# ── Public (build-time) ──────────────────────────────────────────────────────
# Laravel API origin (no trailing /api). If unset, the app silently falls back
# to http://localhost:8000 — including the SEO metadata fetchers, which then
# break social link previews in prod. Always set this.
NEXT_PUBLIC_API_URL=

# Canonical app origin, used for metadata/OG URLs (falls back to
# https://lawexa.com).
NEXT_PUBLIC_APP_URL=

# Realtime (Laravel Reverb). Optional — when absent, realtime features degrade
# to REST politely.
NEXT_PUBLIC_REVERB_APP_KEY=
NEXT_PUBLIC_REVERB_HOST=

# Firebase Cloud Messaging (web push) keys are also NEXT_PUBLIC_* — see
# lib/firebase/messaging.ts for the exact set; push is disabled when absent.

# ── Server (runtime) ─────────────────────────────────────────────────────────
# v2 overhaul kill switch. Unless this is exactly 'true':
#  - proxy.ts is a total no-op (no v1→v2 rewrites), and
#  - the hidden app/v2 tree 404s (guard in app/v2/layout.tsx).
# Read at request time on the Node runtime — flipping it needs a container
# restart, not a rebuild. Keep unset/false in prod until a phase is being
# tested; see docs/v2-docs/overhaul-plan.md §2.
V2_ENABLED=false

# Server-to-server key for the v2 case page's server fetch
# (v2/features/cases/server.ts). With it, the API counts a signed-in reader's
# case view under the reader's own IP and User-Agent, not this server's. Empty
# or unset: the page skips the server fetch and loads as before.
# Rollout order: set the same value in the API's SSR_SHARED_KEYS and deploy the
# API first, then set it here. Set here first, every case read logs a refusal
# on the API and counts the view under this server's address.
# Never prefix it with NEXT_PUBLIC_: that would put it in the browser bundle.
LAWEXA_SSR_KEY=
